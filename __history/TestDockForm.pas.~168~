// 下一页
procedure TTestDockForm.Action2Execute(Sender: TObject);
begin
  if FCurrentEnd >= Length(FBookText) then
    Exit;

  if FCurrentPage + 1 >= FPageStarts.Count then
  begin
    FPageStarts.Add(
      FCurrentEnd + 1
    );
  end;

  Inc(FCurrentPage);

  CalcCurrentPage;

  PaintBox1.Invalidate;
end;


