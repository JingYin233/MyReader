procedure TTestDockForm.JumpToChapter(
  Index: Integer
);
begin

  if Index < 0 then
    Exit;


  if Index >= FChapters.Count then
    Exit;


  BuildChapterPages(Index);


  PaintBox1.Invalidate;

end;

// 下一页
procedure TTestDockForm.Action2Execute(Sender: TObject);
begin

  if FCurrentPage + 1 < FPageStarts.Count then
  begin
    Inc(FCurrentPage);
  end

  else
  begin

    if FCurrentEnd < FChapters[FCurrentChapter].EndPos then
    begin

      FPageStarts.Add(
        FCurrentEnd + 1
      );

      Inc(FCurrentPage);

    end

    else
    begin
      if FCurrentChapter < FChapters.Count-1 then
      begin
        BuildChapterPages(
          FCurrentChapter+1
        );
        Exit;
      end
      else
        Exit;
    end;

  end;


  CalcCurrentPage;

  PaintBox1.Invalidate;

end;


